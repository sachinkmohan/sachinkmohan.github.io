---
import { getCollection } from "astro:content";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";

const topics = (await getCollection("wiki")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Layout>
  <Section>
    <h1>Wiki</h1>

    <p class="text-lg mb-4">
      Useful resources I've found on the internet, by topic.
    </p>

    <ul class="topic-list">
      {
        topics.map((topic) => (
          <li>
            <a href={`/wiki/${topic.id}`}>{topic.data.title}</a>
            <span class="topic-description"> – {topic.data.description}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>

<style>
  .topic-list {
    list-style: disc;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 18px;

    a {
      color: var(--primary);
      font-weight: 500;
    }

    .topic-description {
      color: var(--light);
    }
  }
</style>
